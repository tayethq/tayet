{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM (ADR-088 dec. 5): the shared code runs in the browser (client) and in Node (sidecar).
    "lib": ["ES2022"],
    "module": "ESNext",
    // Same resolution as the client, which consumes this source directly; the Node-ESM shape of the
    // imports is the S-b's call (ADR-088 dec. 7).
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test", "eslint.config.js", "vitest.config.ts"]
}
