  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.3.1",
    "matrix-js-sdk": "41.6.0",
    "node-indexeddb": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.2",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "classic-level@1.4.1": true,
    "fsevents@2.3.3": true
  }
}
