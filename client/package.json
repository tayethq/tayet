{
  "name": "@tayet/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tayet web client: the protocol-hiding chat UI over a domain-only ACL barrel.",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-single-sdk.mjs",
    "preview": "vite preview",
    "tokens": "node style-dictionary.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/ui/**/*.css\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:soak": "SOAK_ROUNDS=20 SOAK_BACKGROUND=1 SOAK_REQUIRE_TTL_MAX=60 playwright test e2e/device-list-staleness.spec.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.3.1",
    "@tayet/shared": "file:../shared",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "matrix-js-sdk": "41.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "25.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.4.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.2",
    "globals": "17.6.0",
    "jsdom": "28.0.0",
    "style-dictionary": "5.7.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
