{
  "color": {
    "greige": {
      "$type": "color",
      "$description": "Neutro do dia — calor sustentado (rampa A). 0 = mais claro, 900 = mais escuro.",
      "0": { "$value": "#FCFBF8" },
      "50": { "$value": "#F8F6F0" },
      "100": { "$value": "#F2EFE7" },
      "200": { "$value": "#EEEBE3" },
      "300": { "$value": "#E4E0D5" },
      "400": { "$value": "#D2CCBE" },
      "500": { "$value": "#B0A998" },
      "600": { "$value": "#88806F" },
      "700": { "$value": "#5F584C" },
      "800": { "$value": "#3D382F" },
      "900": { "$value": "#221F18" }
    },
    "petrol": {
      "$type": "color",
      "$description": "Neutro da noite — peer caloroso, undertone segurado (ADR-027 eixo 3).",
      "50": { "$value": "#E9EEEB" },
      "100": { "$value": "#D2DBD7" },
      "200": { "$value": "#B0BEB8" },
      "300": { "$value": "#8A9C95" },
      "400": { "$value": "#647871" },
      "500": { "$value": "#495C56" },
      "600": { "$value": "#35463F" },
      "700": { "$value": "#27332E" },
      "800": { "$value": "#1B2723" },
      "900": { "$value": "#14201E" }
    },
    "indigo": {
      "$type": "color",
      "$description": "Acento único e semântico (ADR-027 eixo 4) — nunca decorativo.",
      "50": { "$value": "#EDEFF8" },
      "100": { "$value": "#DCE0F2" },
      "200": { "$value": "#BFC6E8" },
      "300": { "$value": "#8A93D6" },
      "400": { "$value": "#6571B6" },
      "500": { "$value": "#4C5A98" },
      "600": { "$value": "#3B4A82" },
      "700": { "$value": "#2D3960" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Base 4px (PLANO §0.2 densidade).",
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Forma contida (PLANO §0.2).",
    "sm": { "$value": "6px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Self-hosted via @fontsource (OFL), sem CDN de terceiro (tese de privacidade, PLANO §0.2).",
      "sans": { "$value": "'Hanken Grotesk Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "mono": { "$value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "$type": "dimension",
      "$description": "Régua: body 15 > ui 14 — confortável na fala, econômico no chrome.",
      "body": { "$value": "15px" },
      "ui": { "$value": "14px" },
      "title": { "$value": "16px" },
      "field": {
        "$value": "16px",
        "$description": "Field text with a coarse pointer or a narrow window: below 16px a phone browser zooms in on focus."
      },
      "display": { "$value": "22px" },
      "meta": { "$value": "12px" },
      "mono": { "$value": "13px" }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Apenas 400 + 500 (600 reservado-com-gatilho, PLANO Deferidos).",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" }
    },
    "line-height": {
      "$type": "number",
      "$description": "Alinhado por papel à escala de size.",
      "body": { "$value": "1.55" },
      "ui": { "$value": "1.4" },
      "title": { "$value": "1.3" },
      "display": { "$value": "1.25" },
      "meta": { "$value": "1.35" },
      "mono": { "$value": "1.5" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Orienta, nunca entretém (PLANO §0.2). prefers-reduced-motion colapsa estas.",
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "280ms" },
      "linger": { "$value": "2400ms", "$description": "Realce da mensagem-alvo da busca: hold 60% + fade (workspace.md §6.1)." },
      "sweep": { "$value": "1200ms", "$description": "Varredura do progresso indeterminado, linear e infinita (workspace.md §6.1)." }
    },
    "ease": {
      "$type": "cubicBezier",
      "$description": "Sem spring/bounce/overshoot.",
      "entrada": { "$value": "cubic-bezier(.2, 0, 0, 1)" },
      "saida": { "$value": "cubic-bezier(.4, 0, 1, 1)" }
    }
  }
}
