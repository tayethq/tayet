{
  "name": "@tayet/push",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Push gateway: receives the homeserver's push notifications, keeps only those the app would show, and sends them as Web Push.",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.2",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
