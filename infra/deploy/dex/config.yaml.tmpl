# Dex — IdP do dogfood em PRODUÇÃO (login.<domínio base>). Stand-in OIDC do seam agnóstico do
# MAS (ADR-048): Dex "burro" — allowlist estática de usuários, SEM connectors. Sua função
# é ser fonte de identidade mínima e exercitar o `upstream_oauth2` do MAS sob TLS real.
#
# allowlist do dogfood — a ÚNICA entrada versionada do `staticPasswords` é o admin de bootstrap,
# renderizado das variáveis BOOTSTRAP_ADMIN_* (deploy.sh, secrets/bootstrap-admin.env); o userID é
# derivado do username. Usuários novos entram em secrets/dex-users.yaml (gitignored; hash bcrypt via
# htpasswd, ver a seção "Identity" de infra/deploy/README.md), que o render anexa ao fim desta lista —
# por isso `staticPasswords` é a ÚLTIMA chave do arquivo — + re-render + restart do dex.
#
# TEMPLATE: os `__PLACEHOLDER__` são preenchidos pelo `deploy.sh secrets` →
# `secrets/rendered/dex-config.yaml` (gitignored). Nenhum secret real neste arquivo.
#
# Forma portada VERBATIM do dev-stack (infra/dev-stack/dex/config.yaml, §0.3): mudam só o
# issuer (host de produção), o redirect (ULID novo do provider) e os secrets.
issuer: https://login.__TAYET_DOMAIN__

# Storage em memória — mesma forma do dev-stack. A allowlist e o client vêm 100% da config
# (sem estado dinâmico a persistir) → o compose não monta volume para o Dex.
storage:
  type: memory

web:
  http: 0.0.0.0:5556

oauth2:
  # Dex burro: sem tela de consentimento — o consentimento do produto é o login no MAS.
  skipApprovalScreen: true

staticClients:
  # Único cliente: o MAS. O redirect é o callback do provider Dex de produção no MAS
  # ({public_base}/upstream/callback/{provider_id}), com o ULID novo pinado no PR-2.
  - id: mas
    name: "Tayet MAS"
    secret: __DEX_CLIENT_SECRET__
    redirectURIs:
      - https://auth.__TAYET_DOMAIN__/upstream/callback/5N76WXKCKTDZV1E79ZM7E1YTG0

# Password DB local: usuários estáticos. username -> claim `name` (o mapping do localpart
# no MAS consome `user.name`, ver mas/config.yaml.tmpl). userID estável por usuário.
enablePasswordDB: true
staticPasswords:
  - email: "__BOOTSTRAP_ADMIN_EMAIL__"
    username: "__BOOTSTRAP_ADMIN_USERNAME__"
    userID: "__BOOTSTRAP_ADMIN_USER_ID__"
    hash: "__BOOTSTRAP_ADMIN_PASSWORD_HASH__"
